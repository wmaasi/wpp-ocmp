<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= campania.titulo %> | Panel OCMP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/output.css" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-100 min-h-screen flex">

  <%- include('../partials/sidebar') %>

  <div class="flex-1 p-8">

    <!-- Header -->
    <div class="flex justify-between items-start mb-6">
      <div>
        <a href="/admin/campanias" class="text-blue-500 text-sm hover:underline">← Campañas</a>
        <h1 class="text-2xl font-bold text-blue-700 mt-1"><%= campania.titulo %></h1>
        <% if (campania.descripcion) { %>
          <p class="text-gray-500 text-sm mt-1"><%= campania.descripcion %></p>
        <% } %>
      </div>
      <div class="flex gap-2 items-center">
        <!-- Cambiar estado -->
        <form action="/admin/campanias/<%= campania.id %>/estado" method="POST" class="inline">
          <select name="estado" onchange="this.form.submit()" class="border rounded-md px-3 py-2 text-sm">
            <% ['borrador','activa','pausada','finalizada','cancelada'].forEach(e => { %>
              <option value="<%= e %>" <%= campania.estado === e ? 'selected' : '' %>><%= e %></option>
            <% }) %>
          </select>
        </form>
        <button onclick="abrirModalMensaje()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm">
          + Agregar mensaje
        </button>
      </div>
    </div>

    <!-- Info campaña -->
    <div class="grid grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-lg p-4 shadow-sm">
        <p class="text-xs text-gray-500">Tipo</p>
        <p class="font-semibold capitalize"><%= campania.tipo %></p>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm">
        <p class="text-xs text-gray-500">Audiencia</p>
        <p class="font-semibold capitalize"><%= campania.audiencia %></p>
      </div>
      <div class="bg-white rounded-lg p-4 shadow-sm">
        <p class="text-xs text-gray-500">Estado</p>
        <p class="font-semibold capitalize"><%= campania.estado %></p>
      </div>
    </div>

    <!-- Mensajes -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Mensajes (<%= mensajes.length %>)</h2>

      <% if (!mensajes.length) { %>
        <p class="text-gray-400 text-sm">No hay mensajes en esta campaña todavía.</p>
      <% } %>

      <div class="space-y-4">
        <% mensajes.forEach((m, i) => { %>
          <div class="border rounded-lg p-4 hover:border-blue-300 transition-colors">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs px-2 py-1 rounded-full font-semibold
                    <%= m.tipo === 'imagen' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                    <%= m.tipo %>
                  </span>
                  <span class="text-xs px-2 py-1 rounded-full font-semibold
                    <%= m.estado === 'enviado' ? 'bg-green-100 text-green-700' :
                        m.estado === 'enviando' ? 'bg-yellow-100 text-yellow-700' :
                        m.estado === 'cancelado' ? 'bg-red-100 text-red-700' :
                        'bg-gray-100 text-gray-700' %>">
                    <%= m.estado %>
                  </span>
                  <% if (m.recurrente) { %>
                    <span class="text-xs px-2 py-1 rounded-full bg-orange-100 text-orange-700 font-semibold">recurrente</span>
                  <% } %>
                </div>
                <p class="text-sm text-gray-700 whitespace-pre-wrap"><%= m.mensaje.substring(0, 200) %><%= m.mensaje.length > 200 ? '...' : '' %></p>
                <% if (m.imagen) { %>
                  <img src="<%= m.imagen %>" class="mt-2 h-16 rounded object-cover">
                <% } %>
                <div class="mt-2 text-xs text-gray-400">
                  <% if (m.fecha_programada) { %>
                    📅 <%= new Date(m.fecha_programada).toLocaleString('es-GT') %>
                  <% } %>
                  <% if (m.frecuencia) { %>
                    | 🔄 <%= m.frecuencia %>
                  <% } %>
                </div>
              </div>
              <div class="flex gap-2 ml-4">
                <% if (m.estado === 'pendiente') { %>
                  <form action="/admin/campanias/<%= campania.id %>/mensajes/<%= m.id %>/enviar" method="POST">
                    <button type="submit" class="text-green-600 hover:text-green-800" title="Enviar ahora">
                      <i data-lucide="send" class="w-5 h-5"></i>
                    </button>
                  </form>
                <% } %>
                <% if (m.estado === 'pendiente') { %>
                  <form action="/admin/campanias/<%= campania.id %>/mensajes/<%= m.id %>/eliminar" method="POST"
                    onsubmit="return confirm('¿Eliminar este mensaje?')">
                    <button type="submit" class="text-red-500 hover:text-red-700" title="Eliminar">
                      <i data-lucide="trash-2" class="w-5 h-5"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Envíos recientes -->
    <% if (envios.length) { %>
    <div class="bg-white rounded-lg shadow-md p-6">
      <h2 class="text-lg font-semibold text-gray-700 mb-4">Envíos recientes</h2>
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-3 py-2 text-left">Suscriptor</th>
            <th class="px-3 py-2 text-left">Número</th>
            <th class="px-3 py-2 text-left">Estado</th>
            <th class="px-3 py-2 text-left">Fecha</th>
          </tr>
        </thead>
        <tbody>
          <% envios.forEach(e => { %>
            <tr class="border-t">
              <td class="px-3 py-2"><%= e.nombre || '-' %></td>
              <td class="px-3 py-2"><%= e.numero %></td>
              <td class="px-3 py-2">
                <span class="<%= e.estado === 'enviado' ? 'text-green-600' : 'text-red-600' %> font-semibold">
                  <%= e.estado %>
                </span>
              </td>
              <td class="px-3 py-2 text-gray-500">
                <%= e.fecha_envio ? new Date(e.fecha_envio).toLocaleString('es-GT') : '-' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Modal agregar mensaje -->
  <div id="modalMensaje" class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-50 z-50">
    <div class="bg-white rounded-lg p-6 w-full max-w-lg shadow-lg mx-4 overflow-y-auto max-h-[90vh]">
      <h2 class="text-xl font-semibold text-blue-700 mb-4">Agregar mensaje</h2>
      <form action="/admin/campanias/<%= campania.id %>/mensajes/crear" method="POST" enctype="multipart/form-data" class="space-y-4">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
          <select name="tipo" id="tipoMensaje" onchange="toggleImagen()" class="w-full border rounded-md px-3 py-2">
            <option value="texto">Texto</option>
            <option value="imagen">Imagen + texto</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Mensaje *</label>
          <textarea name="mensaje" rows="4" required class="w-full border rounded-md px-3 py-2"></textarea>
        </div>

        <div id="campoImagen" class="hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1">Imagen</label>
          <input type="file" name="imagen" accept="image/*" class="w-full border rounded-md px-3 py-2">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Fecha y hora programada</label>
          <input type="datetime-local" name="fecha_programada" class="w-full border rounded-md px-3 py-2">
          <p class="text-xs text-gray-500 mt-1">Dejar vacío para enviar manualmente.</p>
        </div>

        <div class="flex items-center gap-2">
          <input type="checkbox" name="recurrente" id="recurrente" value="1" onchange="toggleFrecuencia()">
          <label for="recurrente" class="text-sm text-gray-700">Mensaje recurrente</label>
        </div>

        <div id="campoFrecuencia" class="hidden">
          <label class="block text-sm font-medium text-gray-700 mb-1">Frecuencia (cron)</label>
          <input type="text" name="frecuencia" placeholder="ej: 0 17 * * 4 (jueves 5pm)" class="w-full border rounded-md px-3 py-2">
          <p class="text-xs text-gray-500 mt-1">Expresión cron estándar.</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Orden</label>
          <input type="number" name="orden" value="1" min="1" class="w-full border rounded-md px-3 py-2">
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="cerrarModalMensaje()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md">
            Cancelar
          </button>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md">
            Guardar mensaje
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    lucide.createIcons();

    function abrirModalMensaje() {
      document.getElementById('modalMensaje').classList.remove('hidden');
      document.getElementById('modalMensaje').classList.add('flex');
    }
    function cerrarModalMensaje() {
      document.getElementById('modalMensaje').classList.add('hidden');
      document.getElementById('modalMensaje').classList.remove('flex');
    }
    function toggleImagen() {
      const tipo = document.getElementById('tipoMensaje').value;
      document.getElementById('campoImagen').classList.toggle('hidden', tipo !== 'imagen');
    }
    function toggleFrecuencia() {
      const checked = document.getElementById('recurrente').checked;
      document.getElementById('campoFrecuencia').classList.toggle('hidden', !checked);
    }
  </script>
</body>
</html>
