<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Campañas | Panel OCMP</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/css/output.css" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-gray-100 min-h-screen flex">

  <%- include('../partials/sidebar') %>

  <div class="flex-1 p-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-2xl font-bold text-blue-700">Campañas</h1>
      <button onclick="abrirModal()" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md shadow">
        + Nueva campaña
      </button>
    </div>

    <div class="overflow-x-auto bg-white shadow-md rounded-lg">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-4 py-3 text-left">Título</th>
            <th class="px-4 py-3 text-left">Tipo</th>
            <th class="px-4 py-3 text-left">Audiencia</th>
            <th class="px-4 py-3 text-left">Mensajes</th>
            <th class="px-4 py-3 text-left">Estado</th>
            <th class="px-4 py-3 text-left">Creada por</th>
            <th class="px-4 py-3 text-left">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (!campanias.length) { %>
            <tr><td colspan="7" class="px-4 py-6 text-gray-500 text-center">No hay campañas registradas.</td></tr>
          <% } %>
          <% campanias.forEach(c => { %>
            <tr class="border-t hover:bg-blue-50 transition-colors">
              <td class="px-4 py-3 font-semibold"><%= c.titulo %></td>
              <td class="px-4 py-3 capitalize"><%= c.tipo %></td>
              <td class="px-4 py-3 capitalize"><%= c.audiencia %></td>
              <td class="px-4 py-3">
                <span class="text-blue-700 font-semibold"><%= c.mensajes_enviados %></span>
                <span class="text-gray-400">/ <%= c.total_mensajes %></span>
              </td>
              <td class="px-4 py-3">
                <% const colores = { borrador: 'gray', activa: 'green', pausada: 'yellow', finalizada: 'blue', cancelada: 'red', enviando: 'purple' } %>
                <span class="px-2 py-1 rounded-full text-xs font-semibold bg-<%= colores[c.estado] || 'gray' %>-100 text-<%= colores[c.estado] || 'gray' %>-700">
                  <%= c.estado %>
                </span>
              </td>
              <td class="px-4 py-3"><%= c.creada_por || '-' %></td>
              <td class="px-4 py-3">
                <a href="/admin/campanias/<%= c.id %>" class="text-blue-600 hover:text-blue-800" title="Ver detalle">
                  <i data-lucide="eye" class="w-5 h-5 inline"></i>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal nueva campaña -->
  <div id="modal" class="fixed inset-0 hidden items-center justify-center bg-black bg-opacity-50 z-50">
    <div class="bg-white rounded-lg p-6 w-full max-w-lg shadow-lg mx-4">
      <h2 class="text-xl font-semibold text-blue-700 mb-4">Nueva campaña</h2>
      <form action="/admin/campanias/crear" method="POST" class="space-y-4">

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Título *</label>
          <input type="text" name="titulo" required class="w-full border rounded-md px-3 py-2">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <textarea name="descripcion" rows="2" class="w-full border rounded-md px-3 py-2"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Tipo</label>
            <select name="tipo" class="w-full border rounded-md px-3 py-2">
              <option value="general">General</option>
              <option value="segmentada">Segmentada</option>
              <option value="recurrente">Recurrente</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Audiencia</label>
            <select name="audiencia" class="w-full border rounded-md px-3 py-2">
              <option value="todos">Todos</option>
              <option value="departamento">Por departamento</option>
              <option value="tema">Por tema</option>
              <option value="lista">Lista específica</option>
            </select>
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button type="button" onclick="cerrarModal()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-md">
            Cancelar
          </button>
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md">
            Crear campaña
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    lucide.createIcons();
    function abrirModal() {
      document.getElementById('modal').classList.remove('hidden');
      document.getElementById('modal').classList.add('flex');
    }
    function cerrarModal() {
      document.getElementById('modal').classList.add('hidden');
      document.getElementById('modal').classList.remove('flex');
    }
  </script>
</body>
</html>
